<!-- ホーム画面 -->
<section class="relative min-h-[calc(100vh-4rem)] overflow-hidden">

  <div class="relative z-10 w-full max-w-7xl mx-auto px-4 pt-12 pb-16 md:pt-16">
  <!-- タイトルセクション -->
  <div class="text-center mb-12">
    <h1 class="home-hero-title text-3xl sm:text-4xl font-bold mb-4 leading-tight">今日は何を食べたいですか？</h1>
    <p class="home-hero-lead text-base sm:text-lg text-gray-600 leading-relaxed">
      「何食べたい？」と聞かれても答えられない。そんな時は、あなたの「キブン」を選ぶだけ。最短1秒で食べたい「キブンメシ」にたどり着けます。
    </p>
  </div>

  <!-- 基本選択 -->
  <div id="kibun-search-cards" class="grid grid-cols-1 md:grid-cols-2 gap-8 w-full items-start">
    <!-- ガッツリ -->
    <div class="bg-red-50 rounded-2xl shadow-lg hover:shadow-2xl transition-all duration-300 border border-red-200 p-8">
      <div class="flex flex-col sm:flex-row items-start gap-5 sm:gap-7 mb-0">
        <%= image_tag 'gattsuri.png', width: 96, height: 96, class: 'object-contain shrink-0' %>
        <div class="flex-1 sm:pr-3">
          <div class="flex flex-col sm:flex-row sm:items-center sm:gap-4">
            <h3 class="text-3xl sm:text-4xl font-extrabold leading-tight whitespace-nowrap text-gray-800">ガッツリ</h3>
            <p class="text-gray-600 text-base sm:text-lg leading-snug mt-2 sm:mt-0">お腹いっぱい食べたい！<br>ボリューム満点の料理</p>
          </div>
          <div class="flex gap-3 mt-4">
            <span class="flex-1 px-3 py-1 bg-red-100 text-red-800 rounded-full text-sm font-medium text-center">とんかつ</span>
            <span class="flex-1 px-3 py-1 bg-red-100 text-red-800 rounded-full text-sm font-medium text-center">ステーキ</span>
            <span class="flex-1 px-3 py-1 bg-red-100 text-red-800 rounded-full text-sm font-medium text-center">カレー</span>
          </div>
        </div>
      </div>
      <%= form_with url: result_path, method: :get, local: true, class: "w-full mt-4" do |form| %>
        <%= form.hidden_field :category, value: "ガッツリ" %>
        <%= form.submit "このキブンですぐ検索",
            class: "kibun-card-submit kibun-card-submit--gattsuri" %>
      <% end %>
    </div>

    <!-- サッパリ -->
    <div class="bg-green-50 rounded-2xl shadow-lg hover:shadow-2xl transition-all duration-300 border border-green-200 p-8">
      <div class="flex flex-col sm:flex-row items-start gap-5 sm:gap-7 mb-0">
        <%= image_tag 'sappari.png', width: 96, height: 96, class: 'object-contain shrink-0' %>
        <div class="flex-1 sm:pr-3">
          <div class="flex flex-col sm:flex-row sm:items-center sm:gap-4">
            <h3 class="text-3xl sm:text-4xl font-extrabold leading-tight whitespace-nowrap text-gray-800">サッパリ</h3>
            <p class="text-gray-600 text-base sm:text-lg leading-snug mt-2 sm:mt-0">軽やかに食べたい！<br>あっさりとした料理</p>
          </div>
          <div class="flex gap-3 mt-4">
            <span class="flex-1 px-3 py-1 bg-green-100 text-green-800 rounded-full text-sm font-medium text-center">そば</span>
            <span class="flex-1 px-3 py-1 bg-green-100 text-green-800 rounded-full text-sm font-medium text-center">サラダ</span>
            <span class="flex-1 px-3 py-1 bg-green-100 text-green-800 rounded-full text-sm font-medium text-center">スープ</span>
          </div>
        </div>
      </div>
      <%= form_with url: result_path, method: :get, local: true, class: "w-full mt-4" do |form| %>
        <%= form.hidden_field :category, value: "サッパリ" %>
        <%= form.submit "このキブンですぐ検索",
            class: "kibun-card-submit kibun-card-submit--sappari" %>
      <% end %>
    </div>
  </div>

  <div class="mt-12 mb-12 text-center space-y-3">
    <p class="text-gray-600">もっと細かく条件を指定したい方は</p>
    <button type="button"
      class="inline-flex items-center gap-2 px-6 py-3 bg-orange-600 text-white rounded-full shadow-md hover:bg-orange-800 transition"
      onclick="const p=document.getElementById('advanced-search-panel'); p.classList.toggle('hidden');">
      <span class="text-lg">⚙ 詳細条件を設定する</span>
    </button>
  </div>

  <div id="advanced-search-panel" class="mt-10 hidden">
    <%= render template: "search/multiple_conditions", locals: { embedded_in_home: true } %>
  </div>

  <div class="mt-14 w-full">
    <section class="bg-white/95 border border-gray-200/80 rounded-2xl shadow-lg p-6 md:p-8">
      <div class="flex flex-col gap-2">
        <h2 class="text-xl font-bold text-gray-800">はじめての使い方（3ステップ）</h2>
      </div>

      <div class="mt-6 grid grid-cols-1 md:grid-cols-3 gap-4">
        <article class="rounded-xl border border-orange-200 bg-orange-50 p-4">
          <p class="text-xs font-bold text-orange-700">STEP 1</p>
          <h3 class="mt-1 text-base font-bold text-gray-800">デスクトップアプリ化</h3>
          <p class="mt-2 text-sm text-gray-700">ブラウザから追加しておくと、次回すぐに開けます。</p>
          <ul class="mt-3 space-y-1 text-xs text-gray-700">
            <li>Chrome: メニュー → 「キャスト、保存、共有」→「ページをアプリとしてインストール」</li>
            <li>Safari: 共有 →「ホーム画面に追加」→「Webアプリとして開く」→追加</li>
          </ul>
        </article>

        <article class="rounded-xl border border-orange-200 bg-orange-50 p-4">
          <p class="text-xs font-bold text-orange-700">STEP 2</p>
          <h3 class="mt-1 text-base font-bold text-gray-800">検索する</h3>
          <p class="mt-2 text-sm text-gray-700">「ガッツリ/サッパリ」か詳細条件で、その日のキブンに合う料理を１つ提案します。</p>
          <a href="#kibun-search-cards" class="inline-flex mt-3 px-3 py-1.5 rounded-lg bg-orange-500 text-white text-sm font-semibold hover:bg-orange-600 transition-colors">キブンを選ぶ</a>
        </article>

        <article class="rounded-xl border border-orange-200 bg-orange-50 p-4">
          <p class="text-xs font-bold text-orange-700">STEP 3</p>
          <h3 class="mt-1 text-base font-bold text-gray-800">履歴/傾向を見る</h3>
          <p class="mt-2 text-sm text-gray-700">検索履歴を確認しながら、あなたの傾向（時間帯やスパイス）をチェックします。</p>
          <div class="mt-3 flex flex-wrap gap-2">
            <% if user_signed_in? %>
              <%= link_to "検索履歴", search_histories_path, class: "inline-flex px-3 py-1.5 rounded-lg border border-orange-300 text-orange-800 bg-white text-sm font-semibold hover:bg-orange-100 transition-colors" %>
              <%= link_to "あなた傾向", trends_search_histories_path, class: "inline-flex px-3 py-1.5 rounded-lg bg-orange-500 text-white text-sm font-semibold hover:bg-orange-600 transition-colors" %>
            <% else %>
              <%= link_to "ログインして使う", new_user_session_path, class: "inline-flex px-3 py-1.5 rounded-lg bg-orange-500 text-white text-sm font-semibold hover:bg-orange-600 transition-colors" %>
            <% end %>
          </div>
        </article>
      </div>
    </section>
  </div>
  </div>
</section>
