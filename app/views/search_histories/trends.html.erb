<div class="min-h-screen">

  <% section_class = "bg-white/95 backdrop-blur-sm border-2 border-white rounded-3xl shadow-lg p-8 hover:shadow-xl transition-shadow duration-300" %>
  <% section_header_class = "flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between mb-6" %>

  <div class="relative z-10 max-w-6xl mx-auto px-4 py-10 space-y-8">
    <header class="space-y-4">
      <div class="flex items-center justify-between flex-wrap gap-4">
        <%= link_to search_histories_path,
              class: "px-6 py-2.5 text-sm font-semibold text-gray-700 bg-white/95 backdrop-blur-sm border-2 border-white shadow-md rounded-full hover:bg-white hover:shadow-lg transition-all duration-200 inline-flex items-center gap-2" do %>
          <span class="text-base">←</span>
          <span>検索履歴へ戻る</span>
        <% end %>
      </div>

      <div class="flex items-center gap-3 pt-2">
        <span class="text-2xl">📈</span>
        <div>
          <h1 class="text-2xl font-bold text-gray-800">ガッツリ派？ or サッパリ派？</h1>
          <p class="text-sm text-gray-600 mt-0.5">検索履歴から時間帯ごとの傾向を可視化します</p>
        </div>
      </div>
    </header>

    <section class="<%= section_class %>">
      <div class="<%= section_header_class %>">
        <div>
          <h2 class="text-xl font-bold text-gray-800 flex items-center gap-2">📊 時間帯別キブングラフ</h2>
          <p class="text-sm text-gray-600 mt-1.5">全期間の検索履歴から「実際に検索した時間帯」に「どんな気分」を選びやすいかを可視化します。</p>
        </div>
        <div class="px-4 py-2 bg-gradient-to-r from-[#ff8142] to-[#ff6b2c] text-white text-sm font-semibold rounded-full shadow-md">
          集計件数: <%= @heatmap[:total] %>
        </div>
      </div>

      <% if @heatmap[:total].positive? %>
        <div class="mt-8 bg-gradient-to-br from-gray-50 to-white p-6 rounded-2xl border border-gray-100">
          <div class="h-80">
            <canvas
              id="time-mood-chart"
              class="w-full h-full"
              height="320"
              data-chart="<%= json_escape(@heatmap[:chart_data].to_json) %>">
            </canvas>
          </div>
        </div>
      <% else %>
        <div class="text-sm text-gray-500 mt-4 text-center py-12 bg-gray-50 rounded-2xl">
          まだ集計できる検索履歴がありません。
        </div>
      <% end %>
    </section>

    <% if @heatmap[:total].positive? %>
      <script>
        (() => {
          const stateKey = "__timeMoodChartState";
          if (!window[stateKey]) {
            window[stateKey] = { chart: null, chartLibPromise: null, bound: false };
          }
          const state = window[stateKey];

          const destroyChart = () => {
            if (state.chart) {
              state.chart.destroy();
              state.chart = null;
            }
          };

          const loadChartJs = () => {
            if (window.Chart) return Promise.resolve(window.Chart);
            if (state.chartLibPromise) return state.chartLibPromise;

            state.chartLibPromise = new Promise((resolve, reject) => {
              const existing = document.querySelector("script[data-chartjs-lib='true']");
              if (existing) {
                if (window.Chart) {
                  resolve(window.Chart);
                  return;
                }
                existing.addEventListener("load", () => resolve(window.Chart), { once: true });
                existing.addEventListener("error", () => reject(new Error("Chart.js load failed")), { once: true });
                return;
              }

              const script = document.createElement("script");
              script.src = "https://cdn.jsdelivr.net/npm/chart.js";
              script.async = true;
              script.dataset.chartjsLib = "true";
              script.addEventListener("load", () => resolve(window.Chart), { once: true });
              script.addEventListener("error", () => reject(new Error("Chart.js load failed")), { once: true });
              document.head.appendChild(script);
            });

            return state.chartLibPromise;
          };

          const renderChart = async () => {
            const canvas = document.getElementById("time-mood-chart");
            if (!canvas || !canvas.dataset.chart) return;

            try {
              await loadChartJs();
            } catch (error) {
              console.error(error);
              return;
            }

            destroyChart();

            const data = JSON.parse(canvas.dataset.chart);
            const context = canvas.getContext("2d");

            state.chart = new window.Chart(context, {
              type: "bar",
              data: data,
              options: {
                responsive: true,
                maintainAspectRatio: false,
                scales: {
                  x: {
                    stacked: false,
                    grid: { display: false },
                    border: { display: false },
                    ticks: { font: { size: 11 } }
                  },
                  y: {
                    stacked: false,
                    beginAtZero: true,
                    ticks: { precision: 0, font: { size: 11 } },
                    grid: { color: "rgba(0, 0, 0, 0.05)" },
                    border: { display: false }
                  }
                },
                plugins: {
                  legend: {
                    position: "bottom",
                    labels: { boxWidth: 12, padding: 15, font: { size: 12 } }
                  },
                  tooltip: {
                    mode: "index",
                    intersect: false,
                    backgroundColor: "rgba(0, 0, 0, 0.8)",
                    padding: 12,
                    cornerRadius: 8
                  }
                }
              }
            });
          };

          if (!state.bound) {
            document.addEventListener("turbo:load", renderChart);
            document.addEventListener("turbo:render", renderChart);
            document.addEventListener("turbo:before-cache", destroyChart);
            state.bound = true;
          }

          renderChart();
        })();
      </script>
    <% end %>

    <section class="<%= section_class %>">
      <div class="<%= section_header_class %>">
        <div>
          <h2 class="text-xl font-bold text-gray-800 flex items-center gap-2">🏆 あなたのスパイスTop5</h2>
          <p class="text-sm text-gray-600 mt-1.5">過去の検索履歴から、よく登場するスパイスを集計しています。</p>
        </div>
        <div class="text-xs text-gray-500 font-medium bg-gray-100 px-4 py-2 rounded-full">対象: 全期間</div>
      </div>

      <% if @spice_summary[:total].to_i > 0 %>
        <div class="hidden bg-amber-800 border-amber-800 text-amber-800 bg-orange-800 border-orange-800 text-orange-800 bg-amber-700 border-amber-700 text-amber-700 bg-orange-700 border-orange-700 text-orange-700 bg-yellow-700 border-yellow-700 text-yellow-700"></div>
        <% spice_image_map = {
          "ブラックペッパー" => "black_pepper.png",
          "ガーリック" => "garlic.png",
          "生姜" => "ginger.png",
          "唐辛子" => "chili.png",
          "クミン" => "cumin.png",
          "コリアンダー" => "coriander.png",
          "ターメリック" => "turmeric.png",
          "パプリカ" => "paprika.png",
          "オレガノ" => "oregano.png",
          "ローズマリー" => "rosemary.png",
          "タイム" => "thyme.png",
          "パセリ" => "parsley.png",
          "ローレル" => "laurel.png",
          "ナツメグ" => "nutmeg.png",
          "クローブ" => "clove.png",
          "山椒" => "sansho.png",
          "カルダモン" => "cardamom.png",
          "シナモン" => "cinnamon.png",
          "バジル" => "basil.png",
          "五香粉" => "gokohfun.png"
        } %>
        <% items = @spice_summary[:items] %>
        <% top_items = items.reject { |item| item[:name] == "その他" } %>
        <% other_item = items.find { |item| item[:name] == "その他" } %>
        <% palette = [
          { bg: "bg-amber-800", border: "border-amber-800", text: "text-amber-800" },
          { bg: "bg-orange-800", border: "border-orange-800", text: "text-orange-800" },
          { bg: "bg-amber-700", border: "border-amber-700", text: "text-amber-700" },
          { bg: "bg-orange-700", border: "border-orange-700", text: "text-orange-700" },
          { bg: "bg-yellow-700", border: "border-yellow-700", text: "text-yellow-700" }
        ] %>
        <% rank_medals = ["🥇", "🥈", "🥉"] %>

        <div class="mt-6 space-y-6">
          <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <% top_items.first(3).each_with_index do |item, index| %>
              <% name = item[:name] %>
              <% color = palette[index % palette.length] %>
              <% spice_image = spice_image_map[name] %>
              <% ratio_value = item[:ratio] || item[:ratio_display] || 0 %>
              <div class="relative bg-gradient-to-br from-white via-white to-gray-50 rounded-2xl p-6 border-2 shadow-lg hover:shadow-xl transition-all duration-300 hover:-translate-y-1 <%= color[:border] %>">
                <div class="absolute -top-3 -right-3 w-12 h-12 rounded-full bg-white border-2 border-gray-200 shadow-lg flex items-center justify-center text-2xl">
                  <%= rank_medals[index] || "" %>
                </div>
                <div class="inline-flex items-center justify-center w-10 h-10 rounded-full text-white font-bold text-lg shadow-md mb-3 <%= color[:bg] %>">
                  <%= index + 1 %>
                </div>
                <div class="flex items-center gap-3 mb-4">
                  <span class="inline-flex h-12 w-12 items-center justify-center rounded-2xl bg-white border border-gray-100 shadow-sm">
                    <% if spice_image.present? %>
                      <%= image_tag spice_image, alt: name, size: "32x32", class: "object-contain", style: "width:32px;height:32px;max-width:32px;max-height:32px;" %>
                    <% else %>
                      <span class="text-sm text-gray-600"><%= name.first %></span>
                    <% end %>
                  </span>
                  <div class="flex-1 min-w-0">
                    <div class="font-bold text-lg text-gray-800 truncate"><%= name %></div>
                    <div class="text-sm text-gray-500"><%= item[:count] %>回登場</div>
                  </div>
                </div>
                <div class="space-y-1">
                  <div class="flex items-center justify-between text-xs text-gray-600">
                    <span class="font-medium">使用率</span>
                    <span class="font-bold text-base <%= color[:text] %>">
                      <%= item[:ratio_display] || 0 %>%
                    </span>
                  </div>
                  <div class="h-3 w-full bg-gray-200 rounded-full overflow-hidden">
                    <div class="h-full rounded-full transition-all duration-500 shadow-sm <%= color[:bg] %>" data-bar-width="<%= ratio_value %>"></div>
                  </div>
                </div>
              </div>
            <% end %>
          </div>

          <% if top_items.drop(3).any? %>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <% top_items.drop(3).first(2).each_with_index do |item, offset| %>
                <% actual_index = offset + 3 %>
                <% name = item[:name] %>
                <% color = palette[actual_index % palette.length] %>
                <% spice_image = spice_image_map[name] %>
                <% ratio_value = item[:ratio] || item[:ratio_display] || 0 %>
                <div class="bg-gradient-to-br from-white to-gray-50 rounded-xl p-5 border-2 border-gray-200 hover:border-gray-300 hover:shadow-md transition-all duration-300">
                  <div class="flex items-center gap-4">
                    <div class="flex-shrink-0 w-9 h-9 rounded-full text-white font-bold flex items-center justify-center shadow-md <%= color[:bg] %>">
                      <%= actual_index + 1 %>
                    </div>
                    <div class="flex items-center gap-3 flex-1 min-w-0">
                      <span class="inline-flex h-10 w-10 items-center justify-center rounded-xl bg-white border border-gray-100 shadow-sm">
                        <% if spice_image.present? %>
                          <%= image_tag spice_image, alt: name, size: "28x28", class: "object-contain", style: "width:28px;height:28px;max-width:28px;max-height:28px;" %>
                        <% else %>
                          <span class="text-xs text-gray-600"><%= name.first %></span>
                        <% end %>
                      </span>
                      <div class="flex-1 min-w-0">
                        <div class="font-bold text-gray-800 truncate"><%= name %></div>
                        <div class="text-xs text-gray-500"><%= item[:count] %>回</div>
                      </div>
                    </div>
                    <div class="flex-shrink-0 text-right">
                      <div class="font-bold text-xl <%= color[:text] %>">
                        <%= item[:ratio_display] || 0 %>%
                      </div>
                    </div>
                  </div>
                  <div class="mt-3 h-2 w-full bg-gray-200 rounded-full overflow-hidden">
                    <div class="h-full rounded-full transition-all duration-500 shadow-sm <%= color[:bg] %>" data-bar-width="<%= ratio_value %>"></div>
                  </div>
                </div>
              <% end %>
            </div>
          <% end %>

      <% else %>
        <div class="text-sm text-gray-500 mt-4 text-center py-12 bg-gray-50 rounded-2xl">
          まだスパイスの履歴がありません。
        </div>
      <% end %>
    </section>

    <% if @spice_summary[:total].to_i > 0 %>
      <script>
        document.addEventListener("turbo:load", () => {
          document.querySelectorAll("[data-bar-width]").forEach((el) => {
            const value = Number(el.dataset.barWidth || 0);
            const safeValue = Math.max(0, Math.min(100, value));
            el.style.width = `${safeValue}%`;
          });
        });
      </script>
    <% end %>
  </div>
</div>
