<div class="min-h-screen">

  <% section_class = "bg-white/95 backdrop-blur-sm border-2 border-white rounded-3xl shadow-lg p-8 hover:shadow-xl transition-shadow duration-300" %>
  <% section_header_class = "flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between mb-6" %>

  <div class="relative z-10 max-w-6xl mx-auto px-4 py-10 space-y-8">
    <header class="space-y-4">
      <div class="flex items-center justify-between flex-wrap gap-4">
        <%= link_to search_histories_path,
              class: "px-6 py-2.5 text-sm font-semibold text-gray-700 bg-white/95 backdrop-blur-sm border-2 border-white shadow-md rounded-full hover:bg-white hover:shadow-lg transition-all duration-200 inline-flex items-center gap-2" do %>
          <span class="text-base">←</span>
          <span>検索履歴へ戻る</span>
        <% end %>
      </div>

      <div class="flex items-center gap-3 pt-2">
        <span class="text-2xl">📈</span>
        <div>
          <h1 class="text-2xl font-bold text-gray-800">ガッツリ派？ or サッパリ派？</h1>
          <p class="text-sm text-gray-600 mt-0.5">検索履歴から時間帯ごとの傾向を可視化します</p>
        </div>
      </div>
    </header>

    <section class="<%= section_class %>">
      <div class="<%= section_header_class %>">
        <div>
          <h2 class="text-xl font-bold text-gray-800 flex items-center gap-2">📊 時間帯別キブングラフ</h2>
          <p class="text-sm text-gray-600 mt-1.5">全期間の検索履歴から「実際に検索した時間帯」に「どんな気分」を選びやすいかを可視化します。</p>
        </div>
        <div class="px-4 py-2 bg-gradient-to-r from-[#ff8142] to-[#ff6b2c] text-white text-sm font-semibold rounded-full shadow-md">
          集計件数: <%= @heatmap[:total] %>
        </div>
      </div>

      <% if @heatmap[:total].positive? %>
        <% mood_labels = Array(@heatmap[:mood_labels]) %>
        <% cells = @heatmap[:cells] || {} %>
        <% totals_by_mood = mood_labels.to_h { |mood| [ mood, (cells[mood] || {}).values.sum ] } %>
        <% dominant_mood, dominant_count = totals_by_mood.max_by { |_, count| count } || ["未分類", 0] %>
        <% secondary_mood, secondary_count = totals_by_mood.reject { |mood, _| mood == dominant_mood }.max_by { |_, count| count } || ["-", 0] %>
        <% dominant_ratio = @heatmap[:total].positive? ? (dominant_count.to_f / @heatmap[:total] * 100.0) : 0.0 %>
        <% secondary_ratio = @heatmap[:total].positive? ? (secondary_count.to_f / @heatmap[:total] * 100.0) : 0.0 %>
        <% gap = (dominant_ratio - secondary_ratio).abs %>
        <% tendency_label =
          if gap >= 20
            "かなり#{dominant_mood}派"
          elsif gap >= 8
            "やや#{dominant_mood}派"
          else
            "拮抗"
          end %>
        <% dominant_tone = dominant_mood == "ガッツリ" ? "text-red-700 bg-red-50 border-red-200" : "text-green-700 bg-green-50 border-green-200" %>
        <div class="mt-2 rounded-2xl border p-4 <%= dominant_tone %>">
          <div class="flex flex-wrap items-center justify-between gap-3">
            <div>
              <p class="text-xs font-semibold tracking-wide">全時間帯の総合判定</p>
              <p class="text-lg font-bold mt-1"><%= tendency_label %></p>
            </div>
            <div class="text-right text-sm">
              <p><span class="font-semibold"><%= dominant_mood %></span>: <%= dominant_count %>回（<%= dominant_ratio.round(1) %>%）</p>
              <p class="text-gray-600"><%= secondary_mood %>: <%= secondary_count %>回（<%= secondary_ratio.round(1) %>%）</p>
            </div>
          </div>
          <div class="mt-3 h-2.5 w-full bg-white/70 rounded-full overflow-hidden border border-white/60">
            <div class="h-full <%= dominant_mood == 'ガッツリ' ? 'bg-red-500' : 'bg-green-500' %>" data-bar-width="<%= dominant_ratio.round(1) %>"></div>
          </div>
        </div>

        <div class="mt-8 bg-gradient-to-br from-gray-50 to-white p-6 rounded-2xl border border-gray-100">
          <div class="h-80">
            <canvas
              id="time-mood-chart"
              class="w-full h-full"
              data-chart="<%= json_escape(@heatmap[:chart_data].to_json) %>">
            </canvas>
          </div>
        </div>
      <% else %>
        <div class="text-sm text-gray-500 mt-4 text-center py-12 bg-gray-50 rounded-2xl">
          まだ集計できる検索履歴がありません。
        </div>
      <% end %>
    </section>

    <% if @heatmap[:total].positive? %>
      <script>
        (() => {
          const stateKey = "__timeMoodChartState";
          if (!window[stateKey]) {
            window[stateKey] = { chart: null, chartLibPromise: null, bound: false, resizeObserver: null };
          }
          const state = window[stateKey];

          const destroyChart = () => {
            if (state.resizeObserver) {
              state.resizeObserver.disconnect();
              state.resizeObserver = null;
            }
            if (state.chart) {
              state.chart.destroy();
              state.chart = null;
            }
          };

          const loadChartJs = () => {
            if (window.Chart) return Promise.resolve(window.Chart);
            if (state.chartLibPromise) return state.chartLibPromise;

            state.chartLibPromise = new Promise((resolve, reject) => {
              const existing = document.querySelector("script[data-chartjs-lib='true']");
              if (existing) {
                if (window.Chart) {
                  resolve(window.Chart);
                  return;
                }
                existing.addEventListener("load", () => resolve(window.Chart), { once: true });
                existing.addEventListener("error", () => reject(new Error("Chart.js load failed")), { once: true });
                return;
              }

              const script = document.createElement("script");
              script.src = "https://cdn.jsdelivr.net/npm/chart.js";
              script.async = true;
              script.dataset.chartjsLib = "true";
              script.addEventListener("load", () => resolve(window.Chart), { once: true });
              script.addEventListener("error", () => reject(new Error("Chart.js load failed")), { once: true });
              document.head.appendChild(script);
            });

            return state.chartLibPromise;
          };

          const renderChart = async () => {
            const canvas = document.getElementById("time-mood-chart");
            if (!canvas || !canvas.dataset.chart) return;

            try {
              await loadChartJs();
            } catch (error) {
              console.error(error);
              return;
            }

            destroyChart();

            const data = JSON.parse(canvas.dataset.chart);
            const totalLabel = "全時間帯";
            if (!data.labels.includes(totalLabel)) {
              data.labels = [...data.labels, totalLabel];
              data.datasets = (data.datasets || []).map((dataset) => {
                const values = Array.isArray(dataset.data) ? dataset.data.map((v) => Number(v || 0)) : [];
                const total = values.reduce((sum, value) => sum + value, 0);
                return { ...dataset, data: [...values, total] };
              });
            }
            const context = canvas.getContext("2d");
            const dpr = Math.min(2, window.devicePixelRatio || 1);

            state.chart = new window.Chart(context, {
              type: "bar",
              data: data,
              options: {
                responsive: true,
                maintainAspectRatio: false,
                devicePixelRatio: dpr,
                scales: {
                  x: {
                    stacked: false,
                    grid: { display: false },
                    border: { display: false },
                    ticks: { font: { size: 11 } }
                  },
                  y: {
                    stacked: false,
                    beginAtZero: true,
                    ticks: { precision: 0, font: { size: 11 } },
                    grid: { color: "rgba(0, 0, 0, 0.05)" },
                    border: { display: false }
                  }
                },
                plugins: {
                  legend: {
                    position: "bottom",
                    labels: { boxWidth: 12, padding: 15, font: { size: 12 } }
                  },
                  tooltip: {
                    mode: "index",
                    intersect: false,
                    backgroundColor: "rgba(0, 0, 0, 0.8)",
                    padding: 12,
                    cornerRadius: 8
                  }
                }
              }
            });

            requestAnimationFrame(() => state.chart && state.chart.resize());
            setTimeout(() => state.chart && state.chart.resize(), 120);

            if (window.ResizeObserver) {
              state.resizeObserver = new ResizeObserver(() => {
                if (state.chart) state.chart.resize();
              });
              const container = canvas.parentElement;
              if (container) state.resizeObserver.observe(container);
            }
          };

          if (!state.bound) {
            document.addEventListener("turbo:load", renderChart);
            document.addEventListener("turbo:render", renderChart);
            document.addEventListener("turbo:before-cache", destroyChart);
            state.bound = true;
          }

          renderChart();
        })();
      </script>
    <% end %>

    <section class="<%= section_class %>">
      <div class="<%= section_header_class %>">
        <div>
          <h2 class="text-xl font-bold text-gray-800 flex items-center gap-2">🏙️ シーン傾向</h2>
          <p class="text-sm text-gray-600 mt-1.5">外食・弁当・内食の選ばれやすさを表示します（過去履歴を含む）。</p>
        </div>
        <div class="text-xs text-gray-500 font-medium bg-gray-100 px-4 py-2 rounded-full">集計件数: <%= @scene_summary[:total] %></div>
      </div>

      <% if @scene_summary[:total].to_i > 0 %>
        <% tone_map = {
          "外食" => { from: "from-rose-50", to: "to-rose-100", border: "border-rose-200", text: "text-rose-800", bar: "bg-rose-500" },
          "弁当" => { from: "from-amber-50", to: "to-amber-100", border: "border-amber-200", text: "text-amber-800", bar: "bg-amber-500" },
          "内食" => { from: "from-emerald-50", to: "to-emerald-100", border: "border-emerald-200", text: "text-emerald-800", bar: "bg-emerald-500" }
        } %>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <% @scene_summary[:items].each do |item| %>
            <% tone = tone_map[item[:name]] || { from: "from-gray-50", to: "to-gray-100", border: "border-gray-200", text: "text-gray-800", bar: "bg-gray-500" } %>
            <article class="rounded-2xl border bg-gradient-to-br <%= tone[:from] %> <%= tone[:to] %> <%= tone[:border] %> p-4 shadow-sm">
              <div class="flex items-center justify-between mb-2">
                <h3 class="font-bold <%= tone[:text] %>"><%= item[:name] %></h3>
                <span class="text-sm font-semibold <%= tone[:text] %>"><%= item[:ratio_display] %>%</span>
              </div>
              <p class="text-sm text-gray-600 mb-3"><%= item[:count] %>回</p>
              <div class="h-2.5 w-full bg-white/80 rounded-full overflow-hidden">
                <div class="h-full <%= tone[:bar] %>" data-bar-width="<%= item[:ratio] %>"></div>
              </div>
            </article>
          <% end %>
        </div>
      <% else %>
        <div class="text-sm text-gray-500 mt-4 text-center py-12 bg-gray-50 rounded-2xl">
          まだシーンの履歴がありません。
        </div>
      <% end %>
    </section>

    <section class="<%= section_class %>">
      <div class="<%= section_header_class %>">
        <div>
          <h2 class="text-xl font-bold text-gray-800 flex items-center gap-2">🧭 時間帯×キブン×スパイス ヒートマップ</h2>
          <p class="text-sm text-gray-600 mt-1.5">朝・昼・夜で、どのスパイスが選ばれやすいかをキブン別に可視化しています（各キブン上位8種）。</p>
        </div>
        <div class="text-xs text-gray-500 font-medium bg-gray-100 px-4 py-2 rounded-full">スパイス登場回数: <%= @time_mood_spice_heatmap[:total] %></div>
      </div>

      <% if @time_mood_spice_heatmap[:total].to_i > 0 %>
        <div class="mb-4 rounded-xl border border-gray-200 bg-gray-50 px-4 py-3">
          <div class="flex flex-wrap items-center gap-2 text-xs text-gray-600">
            <span class="font-semibold">見方:</span>
            <span>色が濃いほど登場回数が多い</span>
            <span class="text-gray-400">・</span>
            <span>「時間帯合計」で朝/昼/夜の強さを比較</span>
          </div>
        </div>
        <div class="grid grid-cols-1 xl:grid-cols-2 gap-6">
          <% @time_mood_spice_heatmap[:mood_labels].each do |mood| %>
            <% rows = @time_mood_spice_heatmap[:rows_by_mood][mood] || [] %>
            <% tone = mood == "ガッツリ" ? { head: "text-red-800", border: "border-red-100", bg: "bg-red-50" } : { head: "text-green-800", border: "border-green-100", bg: "bg-green-50" } %>
            <% time_labels = @time_mood_spice_heatmap[:time_labels] %>
            <% time_totals = time_labels.to_h { |time| [ time, rows.sum { |row| row[:counts][time].to_i } ] } %>
            <% peak_time, peak_count = time_totals.max_by { |_, count| count } || ["-", 0] %>
            <% top_row = rows.max_by { |row| row[:total].to_i } %>
            <% intensity_scale = mood == "ガッツリ" ? %w[bg-red-100 bg-red-200 bg-red-300 bg-red-400 bg-red-500] : %w[bg-green-100 bg-green-200 bg-green-300 bg-green-400 bg-green-500] %>
            <article class="rounded-2xl border <%= tone[:border] %> <%= tone[:bg] %> p-4">
              <div class="flex items-center justify-between mb-3">
                <h3 class="font-bold <%= tone[:head] %>"><%= mood %>で選ばれやすいスパイス</h3>
                <span class="text-xs text-gray-500">登場回数: <%= @time_mood_spice_heatmap[:totals_by_mood][mood].to_i %></span>
              </div>

              <% if rows.any? %>
                <div class="mb-3 flex flex-wrap gap-2 text-xs">
                  <span class="inline-flex items-center rounded-full bg-white/80 px-2.5 py-1 text-gray-700 border border-gray-200">ピーク時間帯: <%= peak_time %>（<%= peak_count %>回）</span>
                  <% if top_row %>
                    <span class="inline-flex items-center rounded-full bg-white/80 px-2.5 py-1 text-gray-700 border border-gray-200">最多スパイス: <%= top_row[:name] %>（<%= top_row[:total] %>回）</span>
                  <% end %>
                </div>
                <div class="mb-2 flex items-center gap-1 text-[11px] text-gray-500">
                  <span>薄</span>
                  <% intensity_scale.each do |bg_class| %>
                    <span class="inline-block h-3.5 w-3.5 rounded-sm border border-white/60 <%= bg_class %>"></span>
                  <% end %>
                  <span>濃</span>
                </div>
                <div class="overflow-x-auto">
                  <table class="min-w-full text-sm border-separate border-spacing-y-1">
                    <thead>
                      <tr class="text-xs text-gray-500">
                        <th class="text-left px-2 py-1">スパイス</th>
                        <% time_labels.each do |time| %>
                          <th class="text-center px-2 py-1">
                            <div><%= time %></div>
                            <div class="text-[10px] text-gray-400 mt-0.5"><%= time_totals[time] %>回</div>
                          </th>
                        <% end %>
                        <th class="text-right px-2 py-1">合計</th>
                      </tr>
                    </thead>
                    <tbody>
                      <% rows.each do |row| %>
                        <tr>
                          <td class="px-2 py-1.5 font-semibold text-gray-800 whitespace-nowrap">
                            <span><%= row[:name] %></span>
                          </td>
                          <% time_labels.each do |time| %>
                            <% count = row[:counts][time].to_i %>
                            <% max_count = @time_mood_spice_heatmap[:max_count].to_i %>
                            <% ratio = max_count.positive? ? (count.to_f / max_count.to_f) : 0.0 %>
                            <% intensity_index =
                              if ratio >= 0.8
                                4
                              elsif ratio >= 0.6
                                3
                              elsif ratio >= 0.4
                                2
                              elsif ratio >= 0.2
                                1
                              else
                                0
                              end %>
                            <% cell_bg = count.positive? ? intensity_scale[intensity_index] : "bg-gray-100" %>
                            <% cell_text = if count.zero?
                                             "text-gray-400"
                                           elsif intensity_index >= 3
                                             "text-white"
                                           else
                                             "text-gray-800"
                                           end %>
                            <td class="px-2 py-1.5 text-center rounded-lg font-semibold <%= cell_bg %> <%= cell_text %>">
                              <%= count.positive? ? count : "–" %>
                            </td>
                          <% end %>
                          <td class="px-2 py-1.5 text-right font-bold text-gray-700"><%= row[:total] %></td>
                        </tr>
                      <% end %>
                    </tbody>
                    <tfoot>
                      <tr class="text-xs text-gray-600">
                        <td class="px-2 py-1.5 font-semibold">時間帯合計</td>
                        <% time_labels.each do |time| %>
                          <td class="px-2 py-1.5 text-center font-semibold"><%= time_totals[time] %></td>
                        <% end %>
                        <td class="px-2 py-1.5 text-right font-bold text-gray-700"><%= rows.sum { |row| row[:total].to_i } %></td>
                      </tr>
                    </tfoot>
                  </table>
                </div>
              <% else %>
                <p class="text-sm text-gray-500 py-8 text-center">このキブンで集計できるスパイス履歴がありません。</p>
              <% end %>
            </article>
          <% end %>
        </div>
      <% else %>
        <div class="text-sm text-gray-500 mt-4 text-center py-12 bg-gray-50 rounded-2xl">
          まだスパイスの時間帯データがありません。
        </div>
      <% end %>
    </section>

    <section class="<%= section_class %>">
      <div class="<%= section_header_class %>">
        <div>
          <h2 class="text-xl font-bold text-gray-800 flex items-center gap-2">🏆 あなたのスパイスTop5</h2>
          <p class="text-sm text-gray-600 mt-1.5">過去の検索履歴から、よく登場するスパイスを集計しています。</p>
        </div>
        <div class="text-xs text-gray-500 font-medium bg-gray-100 px-4 py-2 rounded-full">対象: 全期間</div>
      </div>

      <% if @spice_summary[:total].to_i > 0 %>
        <div class="hidden bg-amber-800 border-amber-800 text-amber-800 bg-orange-800 border-orange-800 text-orange-800 bg-amber-700 border-amber-700 text-amber-700 bg-orange-700 border-orange-700 text-orange-700 bg-yellow-700 border-yellow-700 text-yellow-700"></div>
        <% items = @spice_summary[:items] %>
        <% top_items = items.reject { |item| item[:name] == "その他" } %>
        <% other_item = items.find { |item| item[:name] == "その他" } %>
        <% palette = [
          { bg: "bg-amber-800", border: "border-amber-800", text: "text-amber-800" },
          { bg: "bg-orange-800", border: "border-orange-800", text: "text-orange-800" },
          { bg: "bg-amber-700", border: "border-amber-700", text: "text-amber-700" },
          { bg: "bg-orange-700", border: "border-orange-700", text: "text-orange-700" },
          { bg: "bg-yellow-700", border: "border-yellow-700", text: "text-yellow-700" }
        ] %>
        <% rank_medals = ["🥇", "🥈", "🥉"] %>

        <div class="mt-6 space-y-6">
          <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <% top_items.first(3).each_with_index do |item, index| %>
              <% name = item[:name] %>
              <% color = palette[index % palette.length] %>
              <% spice_image = spice_icon_path(name) %>
              <% ratio_value = item[:ratio] || item[:ratio_display] || 0 %>
              <div class="relative bg-gradient-to-br from-white via-white to-gray-50 rounded-2xl p-6 border-2 shadow-lg hover:shadow-xl transition-all duration-300 hover:-translate-y-1 <%= color[:border] %>">
                <div class="absolute -top-3 -right-3 w-12 h-12 rounded-full bg-white border-2 border-gray-200 shadow-lg flex items-center justify-center text-2xl">
                  <%= rank_medals[index] || "" %>
                </div>
                <div class="inline-flex items-center justify-center w-10 h-10 rounded-full text-white font-bold text-lg shadow-md mb-3 <%= color[:bg] %>">
                  <%= index + 1 %>
                </div>
                <div class="flex items-center gap-3 mb-4">
                  <span class="inline-flex h-12 w-12 items-center justify-center rounded-2xl bg-white border border-gray-100 shadow-sm">
                    <% if spice_image.present? %>
                      <%= image_tag spice_image, alt: name, class: "w-8 h-8 object-contain" %>
                    <% else %>
                      <span class="text-sm text-gray-600"><%= name.first %></span>
                    <% end %>
                  </span>
                  <div class="flex-1 min-w-0">
                    <div class="font-bold text-lg text-gray-800 truncate"><%= name %></div>
                    <div class="text-sm text-gray-500"><%= item[:count] %>回登場</div>
                  </div>
                </div>
                <div class="space-y-1">
                  <div class="flex items-center justify-between text-xs text-gray-600">
                    <span class="font-medium">使用率</span>
                    <span class="font-bold text-base <%= color[:text] %>">
                      <%= item[:ratio_display] || 0 %>%
                    </span>
                  </div>
                  <div class="h-3 w-full bg-gray-200 rounded-full overflow-hidden">
                    <div class="h-full rounded-full transition-all duration-500 shadow-sm <%= color[:bg] %>" data-bar-width="<%= ratio_value %>"></div>
                  </div>
                </div>
              </div>
            <% end %>
          </div>

          <% if top_items.drop(3).any? %>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <% top_items.drop(3).first(2).each_with_index do |item, offset| %>
                <% actual_index = offset + 3 %>
                <% name = item[:name] %>
                <% color = palette[actual_index % palette.length] %>
                <% spice_image = spice_icon_path(name) %>
                <% ratio_value = item[:ratio] || item[:ratio_display] || 0 %>
                <div class="bg-gradient-to-br from-white to-gray-50 rounded-xl p-5 border-2 border-gray-200 hover:border-gray-300 hover:shadow-md transition-all duration-300">
                  <div class="flex items-center gap-4">
                    <div class="flex-shrink-0 w-9 h-9 rounded-full text-white font-bold flex items-center justify-center shadow-md <%= color[:bg] %>">
                      <%= actual_index + 1 %>
                    </div>
                    <div class="flex items-center gap-3 flex-1 min-w-0">
                      <span class="inline-flex h-10 w-10 items-center justify-center rounded-xl bg-white border border-gray-100 shadow-sm">
                        <% if spice_image.present? %>
                          <%= image_tag spice_image, alt: name, class: "w-7 h-7 object-contain" %>
                        <% else %>
                          <span class="text-xs text-gray-600"><%= name.first %></span>
                        <% end %>
                      </span>
                      <div class="flex-1 min-w-0">
                        <div class="font-bold text-gray-800 truncate"><%= name %></div>
                        <div class="text-xs text-gray-500"><%= item[:count] %>回</div>
                      </div>
                    </div>
                    <div class="flex-shrink-0 text-right">
                      <div class="font-bold text-xl <%= color[:text] %>">
                        <%= item[:ratio_display] || 0 %>%
                      </div>
                    </div>
                  </div>
                  <div class="mt-3 h-2 w-full bg-gray-200 rounded-full overflow-hidden">
                    <div class="h-full rounded-full transition-all duration-500 shadow-sm <%= color[:bg] %>" data-bar-width="<%= ratio_value %>"></div>
                  </div>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>

      <% else %>
        <div class="text-sm text-gray-500 mt-4 text-center py-12 bg-gray-50 rounded-2xl">
          まだスパイスの履歴がありません。
        </div>
      <% end %>
    </section>

    <section class="<%= section_class %>">
      <div class="<%= section_header_class %>">
        <div>
          <h2 class="text-xl font-bold text-gray-800 flex items-center gap-2">🍽️ あなたのキブンメシTop10</h2>
          <p class="text-sm text-gray-600 mt-1.5">提案された回数が多い料理をランキング表示しています。</p>
        </div>
        <div class="text-xs text-gray-500 font-medium bg-gray-100 px-4 py-2 rounded-full">対象: 全期間</div>
      </div>

      <% if @kibunmeshi_summary[:total].to_i > 0 %>
        <% kibun_items = @kibunmeshi_summary[:items] %>
        <% kibun_top3 = kibun_items.first(3) %>
        <% kibun_rest = kibun_items.drop(3) %>
        <% kibun_palette = [
          { bg: "bg-amber-800", border: "border-amber-800", text: "text-amber-800" },
          { bg: "bg-orange-800", border: "border-orange-800", text: "text-orange-800" },
          { bg: "bg-amber-700", border: "border-amber-700", text: "text-amber-700" },
          { bg: "bg-orange-700", border: "border-orange-700", text: "text-orange-700" },
          { bg: "bg-yellow-700", border: "border-yellow-700", text: "text-yellow-700" }
        ] %>
        <% rank_medals = ["🥇", "🥈", "🥉"] %>

        <div class="mt-5 space-y-4">
          <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
            <% kibun_top3.each_with_index do |item, index| %>
              <% color = kibun_palette[index % kibun_palette.length] %>
              <% mood = item[:mood] %>
              <% mood_style =
                if mood == "ガッツリ"
                  "bg-red-100 text-red-700"
                elsif mood == "サッパリ"
                  "bg-green-100 text-green-700"
                else
                  "bg-gray-100 text-gray-600"
                end %>
              <article class="relative bg-gradient-to-br from-white via-white to-gray-50 rounded-2xl p-4 border-2 shadow-lg hover:shadow-xl transition-all duration-300 hover:-translate-y-1 <%= color[:border] %>">
                <div class="absolute -top-3 -right-3 w-12 h-12 rounded-full bg-white border-2 border-gray-200 shadow-lg flex items-center justify-center text-2xl">
                  <%= rank_medals[index] || "" %>
                </div>
                <div class="inline-flex items-center justify-center w-9 h-9 rounded-full text-white font-bold text-base shadow-md mb-2 <%= color[:bg] %>">
                  <%= item[:rank] %>
                </div>
                <div class="space-y-1.5 mb-3">
                  <h3 class="font-bold text-base text-gray-800 truncate"><%= item[:name] %></h3>
                  <div>
                    <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-semibold <%= mood_style %>"><%= mood.presence || "未分類" %></span>
                  </div>
                  <p class="text-sm text-gray-500"><%= item[:count] %>回登場</p>
                </div>
              </article>
            <% end %>
          </div>

          <% if kibun_rest.any? %>
            <% kibun_rest_top = kibun_rest.first(4) %>
            <% kibun_rest_bottom = kibun_rest.drop(4) %>
            <div class="space-y-2">
              <div class="grid grid-cols-2 md:grid-cols-4 gap-2">
                <% kibun_rest_top.each do |item| %>
                  <% color = kibun_palette[(item[:rank] - 1) % kibun_palette.length] %>
                  <% mood = item[:mood] %>
                  <% mood_style =
                    if mood == "ガッツリ"
                      "bg-red-100 text-red-700"
                    elsif mood == "サッパリ"
                      "bg-green-100 text-green-700"
                    else
                      "bg-gray-100 text-gray-600"
                    end %>
                  <article class="bg-gradient-to-br from-white to-gray-50 rounded-xl p-3 border-2 border-gray-200 hover:border-gray-300 hover:shadow-sm transition-all duration-300 min-w-0">
                    <div class="flex items-start gap-2">
                      <div class="flex-shrink-0 w-8 h-8 rounded-full text-white text-sm font-bold flex items-center justify-center shadow-sm <%= color[:bg] %>">
                        <%= item[:rank] %>
                      </div>
                      <div class="min-w-0 flex-1">
                        <div class="font-bold text-sm text-gray-800 leading-tight break-words"><%= item[:name] %></div>
                        <div class="mt-1">
                          <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-semibold <%= mood_style %>"><%= mood.presence || "未分類" %></span>
                        </div>
                        <div class="text-xs text-gray-500 mt-1"><%= item[:count] %>回</div>
                      </div>
                    </div>
                  </article>
                <% end %>
              </div>

              <% if kibun_rest_bottom.any? %>
                <div class="grid grid-cols-1 md:grid-cols-4 gap-2">
                  <% kibun_rest_bottom.each do |item| %>
                    <% color = kibun_palette[(item[:rank] - 1) % kibun_palette.length] %>
                    <% mood = item[:mood] %>
                    <% mood_style =
                      if mood == "ガッツリ"
                        "bg-red-100 text-red-700"
                      elsif mood == "サッパリ"
                        "bg-green-100 text-green-700"
                      else
                        "bg-gray-100 text-gray-600"
                      end %>
                    <article class="bg-gradient-to-br from-white to-gray-50 rounded-xl p-3 border-2 border-gray-200 hover:border-gray-300 hover:shadow-sm transition-all duration-300 min-w-0">
                      <div class="flex items-start gap-2">
                        <div class="flex-shrink-0 w-8 h-8 rounded-full text-white text-sm font-bold flex items-center justify-center shadow-sm <%= color[:bg] %>">
                          <%= item[:rank] %>
                        </div>
                        <div class="min-w-0 flex-1">
                          <div class="font-bold text-sm text-gray-800 leading-tight break-words"><%= item[:name] %></div>
                          <div class="mt-1">
                            <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-semibold <%= mood_style %>"><%= mood.presence || "未分類" %></span>
                          </div>
                          <div class="text-xs text-gray-500 mt-1"><%= item[:count] %>回</div>
                        </div>
                      </div>
                    </article>
                  <% end %>
                  <% (4 - kibun_rest_bottom.length).times do %>
                    <div class="hidden md:block" aria-hidden="true"></div>
                  <% end %>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="text-sm text-gray-500 mt-4 text-center py-12 bg-gray-50 rounded-2xl">
          まだキブンメシの履歴がありません。
        </div>
      <% end %>
    </section>

    <script>
      document.addEventListener("turbo:load", () => {
        document.querySelectorAll("[data-bar-width]").forEach((el) => {
          const value = Number(el.dataset.barWidth || 0);
          const safeValue = Math.max(0, Math.min(100, value));
          el.style.width = `${safeValue}%`;
        });
      });
    </script>
  </div>
</div>
