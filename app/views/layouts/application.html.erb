<!DOCTYPE html>
<html>
  <head>
    <% site_name = "キブンメシ" %>
    <% default_description = "キブンで料理を探せるアプリ。ガッツリ/サッパリや詳細条件から、その日の気分に合う一皿をすぐ見つけられます。" %>
    <% page_title = content_for?(:page_title) ? yield(:page_title) : site_name %>

    <title><%= page_title %></title>
    <meta name="application-name" content="<%= site_name %>">
    <meta name="apple-mobile-web-app-title" content="<%= site_name %>">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="theme-color" content="#f97316">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="<%= content_for?(:meta_description) ? yield(:meta_description) : default_description %>">

    <% og_title = content_for?(:og_title) ? yield(:og_title) : page_title %>
    <% og_description = content_for?(:og_description) ? yield(:og_description) : default_description %>
    <% og_url = content_for?(:og_url) ? yield(:og_url) : root_url %>

    <% og_image =
      if content_for?(:og_image)
        yield(:og_image)
      else
        image_url("ogp.png")
      end
    %>

    <meta property="og:type" content="website">
    <meta property="og:site_name" content="<%= site_name %>">
    <meta property="og:title" content="<%= og_title %>">
    <meta property="og:description" content="<%= og_description %>">
    <meta property="og:url" content="<%= og_url %>">
    <meta property="og:image" content="<%= og_image %>">
    <meta property="og:image:secure_url" content="<%= og_image %>">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">

    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="<%= og_title %>">
    <meta name="twitter:description" content="<%= og_description %>">
    <meta name="twitter:image" content="<%= og_image %>">
    <meta name="twitter:image:alt" content="<%= site_name %>">

    <script type="application/ld+json">
      <%= raw({
        "@context": "https://schema.org",
        "@type": "WebSite",
        "name": site_name,
        "alternateName": "kibunmeshi",
        "url": root_url,
        "inLanguage": "ja"
      }.to_json) %>
    </script>

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application" %>
    <%= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>
    <%= tag.link rel: "apple-touch-icon", sizes: "180x180", href: "/apple-touch-icon.png" %>
    <%= favicon_link_tag 'favicon.png' %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <%= render 'shared/header' %>

    <% if flash.any? %>
      <div class="container mx-auto px-4 mt-4">
        <% flash.each do |type, message| %>
          <% next if message.blank? %>
          <div class="mb-3 rounded-md px-4 py-3 text-sm <%= type.to_s == 'notice' ? 'bg-green-50 text-green-800 border border-green-200' : 'bg-red-50 text-red-800 border border-red-200' %>">
            <%= message %>
          </div>
        <% end %>
      </div>
    <% end %>

    <main class="w-full app-main">
      <%= yield %>
    </main>

    <%= render 'shared/mobile_bottom_nav' %>
    <%= render 'shared/footer' %>
  </body>
</html>

